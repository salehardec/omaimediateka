#!/usr/bin/env bash
# oma-mediateka — системный хелпер плагина Omaimediateka.
#
# Доступ к DCIM iPhone через gvfs-afc (см. docs/superpowers/specs) и к
# DCIM/Pictures Android через gvfs-mtp. Скрипт ничего не монтирует от root:
# gvfs монтирует пользовательская сессия, а usbmuxd поднимает udev при
# подключении кабеля. На телефонах только читаем: ни записи, ни удаления.
#
# Подкоманды:
#   status [iphone|android]     — состояние устройства одной JSON-строкой
#   list [--cache KEY] <dir>... — TSV листинг медиафайлов (mtime, size, path)
#   list-cached <KEY>           — последний сохранённый листинг (код 1, если нет)
#   thumb <src> <dst> <kind> [variant]
#                               — превью JPEG в кэш (variant: thumb|preview)
#   meta <src>                  — длительность/размеры (video), TSV
#   index [mount]               — кэш родного индекса Apple (Leo + MediaAnalysis)
#                                 для поиска по смыслу
#   search <query>              — TSV path<TAB>source<TAB>matched
#
# Коды выхода: 0 — успех, 1 — нет данных/ошибка, 5 — поиск по содержимому
# недоступен для этого устройства (не iPhone).
set -u

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
GVFS_DIR="$RUNTIME/gvfs"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omaimediateka"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INDEX_PY="$HERE/oma-mediateka-index.py"
INDEX_DIR="$CACHE_DIR/apple-index"
SEARCH_DB="$CACHE_DIR/search.sqlite"

# --- утилиты ---------------------------------------------------------------

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g'
}

# --- устройства: iPhone (AFC) и Android (MTP) ---------------------------------
#
# Каждый detect_* заполняет глобальные D_* (состояние одного устройства), затем
# save_dev копирует их в префиксные переменные (IPH_*, AND_*). cmd_status
# выбирает одно устройство для показа и перечисляет все найденные в `devices`.

MTP_LIBDIRS="${OMA_GVFS_LIBDIRS:-/usr/lib /usr/lib/gvfs /usr/libexec}"
USB_SYSFS="${OMA_USB_SYSFS:-/sys/bus/usb/devices}"
# Производители телефонов на Android (USB vendor id). Нужны только чтобы отличить
# «Android подключён в режиме зарядки» от «ничего не подключено»: в режиме
# зарядки телефон не открывает MTP и gvfs его не видит.
ANDROID_VENDORS="${OMA_ANDROID_VENDORS:-18d1 04e8 2717 12d1 2a70 22b8 0fce 1004 0bb4 22d9 0b05 2e04 2d95 1bbb 0e8d 19d2 2a45 05c6}"

reset_dev() {
  D_STATE="none"; D_BACKEND="none"; D_NAME=""; D_ID=""; D_MOUNT=""; D_ROOTS=""; D_MSG=""
}

save_dev() {
  declare -g "${1}_STATE=$D_STATE" "${1}_BACKEND=$D_BACKEND" "${1}_NAME=$D_NAME" \
    "${1}_ID=$D_ID" "${1}_MOUNT=$D_MOUNT" "${1}_ROOTS=$D_ROOTS" "${1}_MSG=$D_MSG"
}

load_dev() {
  local v
  for v in STATE BACKEND NAME ID MOUNT ROOTS MSG; do
    local ref="${1}_$v"
    declare -g "D_$v=${!ref}"
  done
}

# JSON-массив строк из списка, разделённого переводами строк.
json_array() {
  local out="" line first=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$first" = 1 ] || out="$out,"
    out="$out\"$(json_escape "$line")\""
    first=0
  done <<< "$1"
  printf '[%s]' "$out"
}

# Один JSON-объект на строку состояния: state type name id mount roots msg.
emit() {
  local type="$1" devices="$2"
  printf '{"state":"%s","backend":"%s","type":"%s","name":"%s","id":"%s","udid":"%s","mount":"%s","dcim":"%s","roots":%s,"devices":%s,"message":"%s"}\n' \
    "$(json_escape "$D_STATE")" "$(json_escape "$D_BACKEND")" "$type" \
    "$(json_escape "$D_NAME")" "$(json_escape "$D_ID")" \
    "$([ "$type" = iphone ] && json_escape "$D_ID")" \
    "$(json_escape "$D_MOUNT")" "$(json_escape "$(printf '%s' "$D_ROOTS" | head -n1)")" \
    "$(json_array "$D_ROOTS")" "$devices" "$(json_escape "$D_MSG")"
}

# Находит каталог монтирования afc для UDID (или любой, если UDID пуст).
find_afc_mount() {
  local udid="${1:-}" d name
  for d in "$GVFS_DIR"/afc:host=*; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    if [ -z "$udid" ] || [[ "$name" == "afc:host=$udid"* ]]; then
      printf '%s' "$d"
      return 0
    fi
  done
  return 1
}

# Каталог монтирования MTP (любой первый).
find_mtp_mount() {
  local d
  for d in "$GVFS_DIR"/mtp:host=*; do
    [ -d "$d" ] || continue
    printf '%s' "$d"
    return 0
  done
  return 1
}

have_gvfs_backend() {
  # $1 — имя демона (gvfsd-afc, gvfsd-mtp), $2 — пакет pacman.
  local d
  for d in $MTP_LIBDIRS; do
    [ -x "$d/$1" ] && return 0
  done
  pacman -Qq "$2" >/dev/null 2>&1
}

detect_iphone() {
  reset_dev
  D_NAME="iPhone"
  if ! command -v idevice_id >/dev/null 2>&1; then
    D_STATE="no-tools"
    D_MSG="Не установлен libimobiledevice. Установите: sudo pacman -S libimobiledevice usbmuxd"
    return 0
  fi

  local udids udid
  udids="$(idevice_id -l 2>/dev/null)"
  if [ -z "$udids" ]; then
    D_STATE="absent"
    return 0
  fi
  udid="$(printf '%s\n' "$udids" | head -n1)"
  D_ID="$udid"

  local paired=1
  if command -v idevicepair >/dev/null 2>&1; then
    idevicepair -u "$udid" validate >/dev/null 2>&1 || paired=0
  fi
  if [ "$paired" = 1 ] && command -v idevicename >/dev/null 2>&1; then
    local nm
    nm="$(timeout 3 idevicename -u "$udid" 2>/dev/null | head -n1)"
    [ -n "$nm" ] && D_NAME="$nm"
  fi

  local backend="none"
  if have_gvfs_backend gvfsd-afc gvfs-afc; then
    backend="gvfs"
  elif command -v ifuse >/dev/null 2>&1; then
    backend="ifuse"
  fi
  D_BACKEND="$backend"

  local mount=""
  mount="$(find_afc_mount "$udid" || true)"

  if [ -z "$mount" ] && [ "$paired" = 1 ] && [ "$backend" = "gvfs" ]; then
    timeout 15 gio mount "afc://$udid/" >/dev/null 2>&1 || true
    mount="$(find_afc_mount "$udid" || true)"
  fi
  D_MOUNT="$mount"

  if [ -n "$mount" ] && [ -d "$mount/DCIM" ]; then
    D_STATE="ready"
    D_ROOTS="$mount/DCIM"
  elif [ -n "$mount" ]; then
    D_STATE="no-dcim"
    D_MSG="Разблокируйте iPhone и подтвердите доступ к фото."
  elif [ "$paired" != 1 ]; then
    D_STATE="unpaired"
    D_MSG="iPhone не доверяет компьютеру. Нажмите «Доверять» на телефоне; при необходимости: idevicepair -u $udid pair"
  elif [ "$backend" = "none" ]; then
    D_STATE="no-backend"
    D_MSG="Нет доступа к файлам iPhone. Установите: sudo pacman -S gvfs-afc"
  else
    D_STATE="mounting"
    D_MSG="Монтирование iPhone… Если не помогает, переподключите кабель."
  fi
}

# Есть ли на USB устройство производителя телефонов (без mass-storage и хабов).
android_usb_present() {
  local dev vid ifc cls bad
  [ -d "$USB_SYSFS" ] || return 1
  for dev in "$USB_SYSFS"/*; do
    [ -r "$dev/idVendor" ] || continue
    vid="$(tr 'A-Z' 'a-z' < "$dev/idVendor" 2>/dev/null)"
    case " $ANDROID_VENDORS " in *" $vid "*) ;; *) continue ;; esac
    bad=0
    for ifc in "$dev"/*:*/bInterfaceClass; do
      [ -r "$ifc" ] || continue
      cls="$(cat "$ifc" 2>/dev/null)"
      case "$cls" in 08|09) bad=1 ;; esac
    done
    [ "$bad" = 1 ] && continue
    return 0
  done
  return 1
}

# Вывод `gio mount -l` (один вызов на status).
GIO_LIST=""
gio_list() {
  [ -n "$GIO_LIST" ] || GIO_LIST="$(timeout 5 gio mount -l 2>/dev/null || true)"
  printf '%s\n' "$GIO_LIST"
}

# URI MTP-томов, которые gvfs видит (activation_root=mtp://…).
mtp_volume_uris() {
  gio_list | sed -n 's/^[[:space:]]*activation_root=\(mtp:\/\/.*\)$/\1/p'
}

# Человеческое имя телефона по хосту: «Mount(0): Pixel 7 -> mtp://host/».
mtp_name_for() {
  local host="$1" name
  local re
  re="$(printf '%s' "$host" | sed 's/[][\.*^$/]/\\&/g')"
  name="$(gio_list | sed -n "s/^Mount([0-9]*): \(.*\) -> mtp:\/\/$re\/\$/\1/p" | head -n1)"
  if [ -z "$name" ]; then
    name="$(gio_list | sed -n "s/^Volume([0-9]*): \(.*\)\$/\1/p" | head -n1)"
  fi
  if [ -z "$name" ]; then
    name="${host//_/ }"
  fi
  printf '%s' "${name:-Android}"
}

detect_android() {
  reset_dev
  D_NAME="Android"
  local mount usb=0 backend=0
  android_usb_present && usb=1
  mount="$(find_mtp_mount || true)"
  have_gvfs_backend gvfsd-mtp gvfs-mtp && backend=1
  [ -n "$mount" ] && backend=1
  [ "$backend" = 1 ] && D_BACKEND="gvfs"

  local uris=""
  if [ -z "$mount" ] && [ "$backend" = 1 ]; then
    uris="$(mtp_volume_uris)"
    local u
    while IFS= read -r u; do
      [ -n "$u" ] || continue
      timeout 15 gio mount "$u" >/dev/null 2>&1 || true
    done <<< "$uris"
    mount="$(find_mtp_mount || true)"
  fi

  if [ -n "$mount" ]; then
    local host
    host="$(basename "$mount")"
    host="${host#mtp:host=}"
    D_ID="$host"
    D_MOUNT="$mount"
    D_NAME="$(mtp_name_for "$host")"
    local roots="" nstorage=0 s sub
    while IFS= read -r s; do
      [ -n "$s" ] || continue
      nstorage=$((nstorage + 1))
      for sub in DCIM Pictures; do
        [ -d "$s/$sub" ] && roots="${roots:+$roots
}$s/$sub"
      done
    done < <(timeout 10 find "$mount" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
    D_ROOTS="$roots"
    if [ -n "$roots" ]; then
      D_STATE="ready"
    elif [ "$nstorage" -gt 0 ]; then
      D_STATE="no-dcim"
      D_MSG="В памяти телефона нет папок DCIM и Pictures."
    else
      D_STATE="locked"
      D_MSG="Разблокируйте телефон и в уведомлении USB выберите «Передача файлов»."
    fi
  elif [ -n "$uris" ]; then
    # Том виден gvfs, но смонтироваться не смог: обычно телефон заблокирован.
    D_STATE="locked"
    D_NAME="$(mtp_name_for "$(printf '%s' "$(printf '%s\n' "$uris" | head -n1)" | sed 's#^mtp://##; s#/$##')")"
    D_MSG="Разблокируйте телефон и в уведомлении USB выберите «Передача файлов»."
  elif [ "$usb" = 1 ] && [ "$backend" = 0 ]; then
    D_STATE="no-backend"
    D_MSG="Нет доступа к файлам Android. Установите: sudo pacman -S gvfs-mtp"
  elif [ "$usb" = 1 ]; then
    D_STATE="charge-only"
    D_MSG="Телефон подключён только для зарядки. Откройте уведомление USB на телефоне и выберите «Передача файлов»."
  else
    D_STATE="absent"
  fi
}

# --- status ----------------------------------------------------------------

# status [iphone|android] — состояние одного устройства JSON-строкой; поле
# `devices` перечисляет все найденные телефоны. Если подключены оба, показывается
# запрошенный тип, иначе первый готовый (iPhone раньше Android).
cmd_status() {
  local prefer="${1:-}"
  detect_iphone; save_dev IPH
  detect_android; save_dev AND

  local devices="" first=1 p type
  for p in IPH AND; do
    local st="${p}_STATE" nm="${p}_NAME" id="${p}_ID"
    case "${!st}" in absent|no-tools|none) continue ;; esac
    [ "$p" = IPH ] && type=iphone || type=android
    [ "$first" = 1 ] || devices="$devices,"
    devices="$devices{\"type\":\"$type\",\"name\":\"$(json_escape "${!nm}")\",\"id\":\"$(json_escape "${!id}")\",\"state\":\"$(json_escape "${!st}")\"}"
    first=0
  done
  devices="[$devices]"

  local pick=""
  if [ "$prefer" = iphone ] && [ "$IPH_STATE" != absent ] && [ "$IPH_STATE" != no-tools ]; then
    pick=IPH
  elif [ "$prefer" = android ] && [ "$AND_STATE" != absent ]; then
    pick=AND
  elif [ "$IPH_STATE" = ready ]; then
    pick=IPH
  elif [ "$AND_STATE" = ready ]; then
    pick=AND
  elif [ "$IPH_STATE" != absent ] && [ "$IPH_STATE" != no-tools ]; then
    pick=IPH
  elif [ "$AND_STATE" != absent ]; then
    pick=AND
  fi

  if [ -n "$pick" ]; then
    load_dev "$pick"
    [ "$pick" = IPH ] && type=iphone || type=android
    emit "$type" "$devices"
    return 0
  fi

  # Ничего не найдено. Без libimobiledevice iPhone не обнаружить вовсе — про это
  # стоит сказать, пока нет другого признака телефона.
  reset_dev
  if [ "$IPH_STATE" = no-tools ] && ! have_gvfs_backend gvfsd-mtp gvfs-mtp; then
    D_STATE="no-tools"
    D_MSG="$IPH_MSG"
    emit "iphone" "$devices"
    return 0
  fi
  D_STATE="no-device"
  D_MSG="Телефон не подключён. iPhone: подключите кабелем и нажмите «Доверять». Android: выберите режим «Передача файлов»."
  emit "none" "$devices"
}

# --- list ------------------------------------------------------------------

cmd_list() {
  local key=""
  if [ "${1:-}" = "--cache" ]; then
    key="$(printf '%s' "${2:-}" | tr -c 'A-Za-z0-9._-' '_')"
    shift 2
  fi
  [ "$#" -gt 0 ] || { echo "usage: oma-mediateka list [--cache KEY] <dir>..." >&2; return 2; }
  local dirs=() d
  for d in "$@"; do
    [ -d "$d" ] && dirs+=("$d")
  done
  [ "${#dirs[@]}" -gt 0 ] || return 0

  # Скрытые файлы и каталоги (.thumbnails, .trashed-*) отсекаются целиком.
  local tmp rc
  tmp="$(mktemp)" || return 1
  find -L "${dirs[@]}" -mindepth 1 \( -name '.*' -o -name '__MACOSX' \) -prune -o \
    -type f \
    ! -iname '*.aae' ! -iname '*.thm' ! -iname '*.xmp' \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.heic' \
       -o -iname '*.heif' -o -iname '*.webp' -o -iname '*.gif' \
       -o -iname '*.mp4' -o -iname '*.mov' -o -iname '*.m4v' \
       -o -iname '*.3gp' -o -iname '*.mkv' -o -iname '*.webm' \) \
    -printf '%T@\t%s\t%p\n' >"$tmp" 2>/dev/null
  rc=$?
  cat "$tmp"
  # MTP через gvfs медленный: полный листинг кладём в кэш, чтобы при следующем
  # подключении показать сетку сразу, пока идёт свежий обход.
  if [ -n "$key" ] && [ "$rc" = 0 ]; then
    mkdir -p "$CACHE_DIR/lists" 2>/dev/null && mv -f "$tmp" "$CACHE_DIR/lists/$key.tsv" && return 0
  fi
  rm -f "$tmp"
  return 0
}

cmd_list_cached() {
  local key
  key="$(printf '%s' "${1:-}" | tr -c 'A-Za-z0-9._-' '_')"
  [ -n "$key" ] && [ -s "$CACHE_DIR/lists/$key.tsv" ] || return 1
  cat "$CACHE_DIR/lists/$key.tsv"
}

# --- thumb -----------------------------------------------------------------

cmd_thumb() {
  local src="${1:-}" dst="${2:-}" kind="${3:-photo}" variant="${4:-thumb}"
  [ -n "$src" ] && [ -n "$dst" ] || { echo "usage: oma-mediateka thumb <src> <dst> <kind> [variant]" >&2; return 2; }
  [ -s "$dst" ] && return 0

  local max=384
  [ "$variant" = "preview" ] && max=2048

  mkdir -p "$(dirname "$dst")" 2>/dev/null || true
  local tmp
  tmp="$(mktemp --suffix=.jpg "${dst}.XXXXXX" 2>/dev/null)" || return 1
  local scale="scale=min(${max}\,iw):min(${max}\,ih):force_original_aspect_ratio=decrease"
  local ext="${src##*.}"
  ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  local ok=0

  case "$kind" in
    photo)
      if [ "$ext" = "heic" ] || [ "$ext" = "heif" ]; then
        local td
        td="$(mktemp -d)"
        if timeout 120 heif-convert -q 85 "$src" "$td/img.jpg" >/dev/null 2>&1; then
          local first
          first="$(ls "$td"/*.jpg 2>/dev/null | head -n1)"
          if [ -n "$first" ] && \
             timeout 60 ffmpeg -y -loglevel error -i "$first" -vf "$scale" -frames:v 1 "$tmp" >/dev/null 2>&1; then
            ok=1
          fi
        fi
        rm -rf "$td"
      else
        if timeout 120 ffmpeg -y -loglevel error -i "$src" -vf "$scale" -frames:v 1 "$tmp" >/dev/null 2>&1; then
          ok=1
        fi
      fi
      ;;
    video)
      if timeout 120 ffmpeg -y -loglevel error -ss 0.5 -i "$src" -vf "$scale" -frames:v 1 "$tmp" >/dev/null 2>&1; then
        ok=1
      fi
      ;;
  esac

  if [ "$ok" = 1 ] && [ -s "$tmp" ]; then
    mv -f "$tmp" "$dst"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# --- meta ------------------------------------------------------------------

cmd_meta() {
  local src="${1:-}"
  [ -n "$src" ] || { echo "usage: oma-mediateka meta <src>" >&2; return 2; }
  command -v ffprobe >/dev/null 2>&1 || return 1
  # Один вызов ffprobe: gvfs-mtp при каждом открытии скачивает файл целиком.
  local dur="" w="" h="" line
  while IFS= read -r line; do
    case "$line" in
      duration=*) [ -n "$dur" ] || dur="${line#duration=}" ;;
      width=*)    [ -n "$w" ] || w="${line#width=}" ;;
      height=*)   [ -n "$h" ] || h="${line#height=}" ;;
    esac
  done < <(timeout 60 ffprobe -v error -select_streams v:0 \
    -show_entries format=duration:stream=width,height -of default=nw=1 "$src" 2>/dev/null)
  printf '%s\t%s\t%s\n' "${dur:-0}" "${w:-0}" "${h:-0}"
}

# --- export ----------------------------------------------------------------

# Список имён в каталоге (каталог создаётся при отсутствии). Одно имя на строку.
cmd_names() {
  local dir="${1:-}"
  [ -n "$dir" ] || { echo "usage: oma-mediateka names <dir>" >&2; return 2; }
  mkdir -p "$dir" 2>/dev/null || return 1
  find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null
}

# Копирование оригинала без перекодирования. Никогда не перезаписывает:
# если приёмник существует — код 3 (вызывающий подбирает суффикс).
cmd_copy() {
  local src="${1:-}" dst="${2:-}"
  [ -n "$src" ] && [ -n "$dst" ] || { echo "usage: oma-mediateka copy <src> <dst>" >&2; return 2; }
  [ -f "$src" ] || { echo "source not found: $src" >&2; return 1; }
  mkdir -p "$(dirname "$dst")" 2>/dev/null || return 1
  if [ -e "$dst" ]; then echo "exists" >&2; return 3; fi
  cp -- "$src" "$dst" 2>/dev/null || return 1
  printf '%s\n' "$dst"
}

# Фото в буфер обмена как image/png (HEIC декодируется heif-convert).
cmd_clip_image() {
  local src="${1:-}"
  [ -n "$src" ] || { echo "usage: oma-mediateka clip-image <src>" >&2; return 2; }
  command -v wl-copy >/dev/null 2>&1 || return 4
  local ext; ext="$(printf '%s' "${src##*.}" | tr 'A-Z' 'a-z')"
  local td png
  td="$(mktemp -d)" || return 1
  if [ "$ext" = "heic" ] || [ "$ext" = "heif" ]; then
    heif-convert -q 92 "$src" "$td/img.png" >/dev/null 2>&1 || true
  else
    ffmpeg -y -loglevel error -i "$src" -frames:v 1 "$td/img.png" >/dev/null 2>&1 || true
  fi
  png="$(ls "$td"/*.png 2>/dev/null | head -n1)"
  if [ -n "$png" ] && [ -s "$png" ]; then
    wl-copy --type image/png < "$png"
    local rc=$?
    rm -rf "$td"
    return $rc
  fi
  rm -rf "$td"
  return 1
}

# Текст (путь к файлу видео/прочего) в буфер обмена.
cmd_clip_text() {
  local text="${1:-}"
  command -v wl-copy >/dev/null 2>&1 || return 4
  printf '%s' "$text" | wl-copy
}

# Выбор каталога: zenity, иначе kdialog. Путь печатается в stdout.
cmd_pick_dir() {
  local start="${1:-$HOME}"
  if command -v zenity >/dev/null 2>&1; then
    zenity --file-selection --directory --title="Куда сохранить" --filename="$start/" 2>/dev/null
  elif command -v kdialog >/dev/null 2>&1; then
    kdialog --getexistingdirectory "$start" 2>/dev/null
  else
    return 4
  fi
}

# --- поиск по содержимому (родной индекс Apple) ----------------------------

# index [mount] — копирует базы с iPhone (только чтение) и собирает компактный
# sqlite-кэш (родные лексемы Leo + метки сцен/действий/питомцев из
# MediaAnalysis + caption'ы). Инкрементально: при том же -wal и том же
# устройстве ничего не делает. Печатает прогресс; код 0 — индекс готов,
# 1 — нет телефона/баз, 4 — нет python3.
cmd_index() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "Для поиска по содержимому нужен python3" >&2
    return 4
  fi
  local mount="${1:-}"
  case "$mount" in
    *mtp:host=*) echo "Поиск по содержимому доступен только для iPhone" >&2; return 5 ;;
  esac
  [ -n "$mount" ] || mount="$(find_afc_mount "" || true)"
  [ -n "$mount" ] || { echo "iPhone не смонтирован" >&2; return 1; }
  local udid
  udid="$(basename "$mount")"
  udid="${udid#afc:host=}"
  python3 "$INDEX_PY" index "$mount" "$INDEX_DIR" "$SEARCH_DB" "$udid"
}

# search <query> — TSV path<TAB>source<TAB>matched из локального кэша.
cmd_search() {
  local query="${1:-}"
  [ -n "$query" ] || return 0
  local mount
  mount="$(find_afc_mount "" || true)"
  if [ -z "$mount" ] && find_mtp_mount >/dev/null; then
    echo "Поиск по содержимому доступен только для iPhone" >&2
    return 5
  fi
  [ -f "$SEARCH_DB" ] || return 1
  if ! command -v python3 >/dev/null 2>&1; then return 4; fi
  python3 "$INDEX_PY" search "$mount" "$SEARCH_DB" "$query"
}

# --- dispatch --------------------------------------------------------------

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  list)   shift; cmd_list "$@" ;;
  list-cached) shift; cmd_list_cached "$@" ;;
  thumb)  shift; cmd_thumb "$@" ;;
  meta)   shift; cmd_meta "$@" ;;
  names)  shift; cmd_names "$@" ;;
  copy)   shift; cmd_copy "$@" ;;
  clip-image) shift; cmd_clip_image "$@" ;;
  clip-text)  shift; cmd_clip_text "$@" ;;
  pick-dir)   shift; cmd_pick_dir "$@" ;;
  index)      shift; cmd_index "$@" ;;
  search)     shift; cmd_search "$@" ;;
  *)
    cat >&2 <<'USAGE'
usage: oma-mediateka <command> [args]
  status [iphone|android]
  list [--cache KEY] <dir>...
  list-cached <KEY>
  thumb <src> <dst> <kind> [thumb|preview]
  meta <src>
  names <dir>
  copy <src> <dst>
  clip-image <src>
  clip-text <text>
  pick-dir [start]
  index [mount]
  search <query>
USAGE
    exit 2
    ;;
esac
